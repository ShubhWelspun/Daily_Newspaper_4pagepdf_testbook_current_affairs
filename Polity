# ---------------------------------------------------------------- helpers

class SolveBox(Flowable):
    """A bordered empty rectangle for the reader to work out the answer."""
    def __init__(self, width, height=2.6*cm, label="Solve here"):
        Flowable.__init__(self)
        self.width = width
        self.height = height
        self.label = label

    def draw(self):
        c = self.canv
        c.saveState()
        c.setStrokeColor(colors.HexColor('#8AA0BF'))
        c.setLineWidth(0.6)
        c.setDash(2, 2)
        c.rect(0, 0, self.width, self.height)
        c.setDash()
        c.setFont('Helvetica-Oblique', 6.5)
        c.setFillColor(colors.HexColor('#9AA7B5'))
        c.drawString(3, self.height - 8, self.label)
        c.restoreState()

    def wrap(self, availWidth, availHeight):
        return (self.width, self.height)


def section_header(text):
    return Paragraph(text, S_SECTION)


def sub_header(text):
    return Paragraph(text, S_SUB)


def body(text):
    return Paragraph(text, S_BODY)


def bullet(text):
    return Paragraph("&bull;&nbsp;" + text, S_BULLET)


def make_table(data, col_widths, header=True, font_size=7.8):
    style_cmds = [
        ('GRID', (0, 0), (-1, -1), 0.5, colors.HexColor('#B9C6D6')),
        ('VALIGN', (0, 0), (-1, -1), 'TOP'),
        ('LEFTPADDING', (0, 0), (-1, -1), 3),
        ('RIGHTPADDING', (0, 0), (-1, -1), 3),
        ('TOPPADDING', (0, 0), (-1, -1), 2),
        ('BOTTOMPADDING', (0, 0), (-1, -1), 2),
        ('FONTSIZE', (0, 0), (-1, -1), font_size),
    ]
    if header:
        style_cmds += [
            ('BACKGROUND', (0, 0), (-1, 0), NAVY2),
            ('TEXTCOLOR', (0, 0), (-1, 0), colors.white),
            ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
        ]
    style_cmds.append(('ROWBACKGROUNDS', (0, 1 if header else 0), (-1, -1), [colors.white, LIGHT]))
    t = Table(data, colWidths=col_widths, repeatRows=1 if header else 0)
    t.setStyle(TableStyle(style_cmds))
    return t


def wrap_row(row):
    return [Paragraph(str(c), S_TABLE_CELL) for c in row]


def wrap_ans_row(row):
    return [Paragraph(str(c), S_ANS_CELL) for c in row]


# ---------------------------------------------------------------- page template

def header_footer(canvas, doc):
    canvas.saveState()
    canvas.setFont('Helvetica-Bold', 8)
    canvas.setFillColor(NAVY)
    canvas.drawString(MARGIN, PAGE_H - 0.75*cm, HEADER_TEXT)
    canvas.setStrokeColor(GOLD)
    canvas.setLineWidth(1.1)
    canvas.line(MARGIN, PAGE_H - 0.85*cm, PAGE_W - MARGIN, PAGE_H - 0.85*cm)
    canvas.setFont('Helvetica', 7.5)
    canvas.setFillColor(GREY)
    canvas.drawCentredString(PAGE_W/2.0, 0.55*cm, f"Page {doc.page}")
    canvas.drawRightString(PAGE_W - MARGIN, 0.55*cm, "Indian Polity — Compact Notes")
    canvas.restoreState()


def build_doc(filename):
    doc = BaseDocTemplate(filename, pagesize=A4,
                           leftMargin=MARGIN, rightMargin=MARGIN,
                           topMargin=1.1*cm, bottomMargin=0.9*cm)
    top = PAGE_H - 1.1*cm - 0.35*cm
    bottom = 0.9*cm
    frame_h = top - bottom
    frame1 = Frame(MARGIN, bottom, COL_W, frame_h, id='col1',
                    leftPadding=0, rightPadding=6, topPadding=0, bottomPadding=0)
    frame2 = Frame(MARGIN + COL_W + GUTTER, bottom, COL_W, frame_h, id='col2',
                    leftPadding=6, rightPadding=0, topPadding=0, bottomPadding=0)
    template = PageTemplate(id='TwoCol', frames=[frame1, frame2], onPage=header_footer)
    doc.addPageTemplates([template])
    return doc

